# HDMI framebuffer, for screen_rotate_two. Here rather than in the .qsf, where
# the template has it commented out, because Quartus rewrites the .qsf: the
# Fuuki core lost it that way and built with every FB_* port an implicit
# 1-bit net, with only a warning to say so.
set_global_assignment -name VERILOG_MACRO "MISTER_FB=1"

set_global_assignment -name SDC_FILE BallySente.sdc
set_global_assignment -name SYSTEMVERILOG_FILE BallySente.sv

# The machine: rtl/balsente_core.sv and what it instantiates.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/balsente_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/pause_control.sv
# Sorgelig's HDMI rotator, GPL-2.0-or-later, as the Fuuki core carries it.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/screen_rotate_two.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/game_board.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/main_bus.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/adc.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/analog_inputs.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/irq_timer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/acia6850.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/video.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/video_timing.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/sprite_engine.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/sente6vb.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/sente6vb_io.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/sente6vb_c0timer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/sente6vb_steptab.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/pit8253.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/sente6vb_audio.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/sente6vb_params.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/cem3394_coef.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/cem3394_vco.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/vco_blep.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/vco_blamp.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/cem3394_lpf4.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/tanh_lut.sv
set_global_assignment -name SEARCH_PATH rtl/sound

# MC6809E, vendored -- see rtl/cpu/mc6809/PROVENANCE.md.
set_global_assignment -name VERILOG_FILE rtl/cpu/mc6809/mc6809i.v

# T80 (Z80), vendored -- see rtl/cpu/t80/PROVENANCE.md.
set_global_assignment -name VHDL_FILE rtl/cpu/t80/T80_Pack.vhd
set_global_assignment -name VHDL_FILE rtl/cpu/t80/T80_MCode.vhd
set_global_assignment -name VHDL_FILE rtl/cpu/t80/T80_ALU.vhd
set_global_assignment -name VHDL_FILE rtl/cpu/t80/T80_Reg.vhd
set_global_assignment -name VHDL_FILE rtl/cpu/t80/T80.vhd
set_global_assignment -name VHDL_FILE rtl/cpu/t80/T80se.vhd
