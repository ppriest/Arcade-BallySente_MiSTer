# Standalone synthesis and timing check for mc6809i. Phase 0 criterion 4.
# Device settings copied from sys/sys.tcl so the numbers are for the board this
# core targets, not for whatever Quartus would default to.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name DEVICE_FILTER_PACKAGE UFBGA
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 672
set_global_assignment -name DEVICE_FILTER_SPEED_GRADE 7
set_global_assignment -name TOP_LEVEL_ENTITY mc6809_synth_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"

set_global_assignment -name VERILOG_FILE ../mc6809/mc6809i.v
set_global_assignment -name SYSTEMVERILOG_FILE mc6809_synth_top.sv
set_global_assignment -name SDC_FILE mc6809_synth_check.sdc
